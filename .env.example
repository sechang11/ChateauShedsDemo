# Railway supplies PORT. The site is fully static once built, with no
# server-side dependencies and no API keys.
PORT=4173

# Optional. Where the quote form's mailto is addressed. Defaults to the real
# Chateau Sheds inbox, which is right for a local build and wrong for a public
# one — a hosted demo would otherwise put live enquiries in front of a business
# that did not send anyone here. Read at BUILD time, so set it before
# `npm run build` (on Railway: add the service variable, then redeploy).
# VITE_QUOTE_EMAIL=you@example.com

# Optional. A custom domain for the deployed demo, appended to vite's
# preview.allowedHosts. Not needed for *.railway.app, already allowed.
# PUBLIC_HOST=demo.example.com
